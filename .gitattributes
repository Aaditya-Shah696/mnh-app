# Files that run on the Linux server must never get Windows line endings.
* text=auto
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
Caddyfile   text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.ini       text eol=lf
*.mako      text eol=lf
*.lock      text eol=lf
*.txt       text eol=lf
*.log       text eol=lf
*.ps1       text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.db  binary
