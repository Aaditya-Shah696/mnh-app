# Files that run on the Linux server must never get Windows line endings.
* text=auto
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
Caddyfile   text eol=lf
*.py        text eol=lf
*.ps1       text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.db  binary
