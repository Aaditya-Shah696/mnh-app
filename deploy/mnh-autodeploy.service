# One autodeploy check, run by mnh-autodeploy.timer. Deploys the
# `production` branch when CI has moved it. Logs: journalctl -u mnh-autodeploy
[Unit]
Description=MNH Discharge Records autodeploy (pull production branch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/mnh/autodeploy.sh
TimeoutStartSec=50min
