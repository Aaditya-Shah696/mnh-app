# Install: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Caddy obtains and renews the Let's Encrypt certificate itself as long as
# the DNS A record for mnhapp.org points here and ports 80 + 443 are open.
# Port 80 is used for the ACME challenge; everything else on it is
# redirected to HTTPS by Caddy automatically.

www.mnhapp.org {
    redir https://mnhapp.org{uri} permanent
}

mnhapp.org {
    encode zstd gzip

    request_body {
        max_size 2MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 50MiB
            roll_keep 10
            roll_keep_for 336h
        }
        format json
    }

    reverse_proxy 127.0.0.1:8021 {
        # Uvicorn is started with --proxy-headers, so the app sees the
        # real client IP in the audit log.
        header_up X-Forwarded-For {remote_host}
    }
}
